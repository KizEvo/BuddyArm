<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="BuddyArm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import BuddyArm urdf file -->
    <xacro:include filename="$(find buddyarm_urdf)/src/robot_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="BuddyArm.ros2_control.xacro" />


    <xacro:BuddyArm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
