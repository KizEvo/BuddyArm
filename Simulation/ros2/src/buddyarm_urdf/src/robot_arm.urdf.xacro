<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="BuddyArm">

  <!--
  =============================================================
                              MACROs
  =============================================================
  -->
  <!-- Params: box: depth/width/heigh and origin xyz -->
  <xacro:macro name="collision_ele" params="d w h x y z roll pitch yaw">
    <collision>
      <geometry>
        <box size="${d} ${w} ${h}"/>
      </geometry>
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
    </collision>
  </xacro:macro>

  <!--
  =============================================================
                              LINKS
  Origin values based on FreeCAD assembly translation and
  rotation
  =============================================================
   -->

  <link name="mcu_base_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-Base.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J1_Base.dae"/>
      </geometry>
      <origin xyz="0 0.075 0.018"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J1_Turret_Housing.dae"/>
      </geometry>
      <origin xyz="0 0.225 0.025"/>
    </visual>
    <xacro:collision_ele d="0.150" w="0.370" h="0.018" x="0" y="0.110" z="0.009" roll="0" pitch="0" yaw="0"/>
  </link>

  <link name="j1_spindle_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J1_Spindle.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J1_Platform.dae"/>
      </geometry>
      <origin xyz="0 0 0.097"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J2_Turret_Housing.dae"/>
      </geometry>
      <origin rpy="${pi/2} -0.000000 ${-pi/2}" xyz="-0.0210 0.0200 0.0970"/>
    </visual>
    <xacro:collision_ele d="0.089" w="0.089" h="0.064" x="0" y="0" z="0.064" roll="0" pitch="0" yaw="0"/>
  </link>

  <link name="j2_spindle_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J2_Spindle.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J2_Tension_Ring.dae"/>
      </geometry>
      <origin rpy="${-pi} -0.000000 0.000000" xyz="0.0000 -0.0000 0.0710"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J2_Arm.dae"/>
      </geometry>
      <origin rpy="0.000000 ${-pi/2} -0.000000" xyz="0.0300 -0.0300 0.0050"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J3_Bearing_Cup.dae"/>
      </geometry>
      <origin rpy="${-pi} 0.000000 ${pi/2}" xyz="0.0000 0.2330 0.0370"/>
    </visual>
    <xacro:collision_ele d="0.076" w="0.163" h="0.060" x="0" y="0.1152" z="0.0432" roll="0" pitch="${-pi/2}" yaw="0"/>
  </link>

  <link name="j3_spindle_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J3_Spindle.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J4_Turret_Housing.dae"/>
      </geometry>
      <origin rpy="${-pi} 0 0" xyz="0 0 0"/>
    </visual>
    <xacro:collision_ele d="0.060" w="0.042" h="0.044" x="-0.0570" y="-0.0320" z="0.0100" roll="0" pitch="${-pi/2}" yaw="${pi/2}"/>
  </link>

  <link name="j4_spindle_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J4_Spindle.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J5_Arm.dae"/>
      </geometry>
      <origin rpy="${-pi/2} -0.000000 ${pi/2}" xyz="0.0210 -0.0170 -0.0000"/>
    </visual>
    <xacro:collision_ele d="0.125" w="0.042" h="0.020" x="0" y="-0.0150" z="-0.0624" roll="0" pitch="${-pi/2}" yaw="${-pi/2}"/>
  </link>

  <link name="j5_spindle_link">
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J5_Spindle.dae"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-J6_Arm.dae"/>
      </geometry>
      <origin rpy="0.000000 -0.000000 0.000000" xyz="0.0000 -0.0000 0.0250"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://buddyarm_urdf/mesh/buddy_arm-11HS20-0674D-EGS16-J6-Motor.dae"/>
      </geometry>
      <origin rpy="${-pi/2} -0.000000 ${pi/2}" xyz="0.0620 0.0019 0.0512"/>
    </visual>
    <xacro:collision_ele d="0.042" w="0.030" h="0.126" x="0.0450" y="0" z="0.0460" roll="0" pitch="${-pi/2}" yaw="${-pi}"/>
  </link>

  <link name="end_effector">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.02"/>
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!--
  =============================================================
                              JOINTs
  Origin values based on FreeCAD assembly translation and
  rotation
  - mcu_base is the origin positon 0,0,0
  - see 'Hardware/' under 'phunguyen/basic-assembly' branch,
   grep for 'zero pose' commit.
  =============================================================
   -->

  <joint name="j1" type="revolute">
    <parent link="mcu_base_link"/>
    <child link="j1_spindle_link"/>
    <origin rpy="0.000000 -0.000000 0.000000" xyz="0.0000 0.2250 -0.0070"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi/2}" upper="${-pi/2}" effort="1000.0" velocity="0.2"/>
  </joint>

  <joint name="j2" type="revolute">
    <parent link="j1_spindle_link"/>
    <child link="j2_spindle_link"/>
    <origin rpy="${pi/2} -0.000000 ${pi/2}" xyz="-0.0610 0.0600 0.1470"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi/7}" upper="${-pi/2}" effort="1000.0" velocity="0.2"/>
  </joint>

  <joint name="j3" type="revolute">
    <parent link="j2_spindle_link"/>
    <child link="j3_spindle_link"/>
    <origin rpy="${pi} -0.000000 ${-pi/2}" xyz="0.0000 0.2330 0.0570"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi/2}" upper="${-pi/2}" effort="1000.0" velocity="0.2"/>
  </joint>

  <joint name="j4" type="revolute">
    <parent link="j3_spindle_link"/>
    <child link="j4_spindle_link"/>
    <origin rpy="${-pi/2} -0.000000 0.000000" xyz="-0.0570 -0.0620 0.0190"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi * 1.5}" upper="${-pi * 1.5}" effort="1000.0" velocity="0.2"/>
  </joint>

  <joint name="j5" type="revolute">
    <parent link="j4_spindle_link"/>
    <child link="j5_spindle_link"/>
    <origin rpy="0.000000 ${pi/2} ${pi/2}" xyz="-0.0000 -0.0200 -0.1075"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi/2}" upper="${-pi/2}" effort="1000.0" velocity="0.2"/>
  </joint>

  <joint name="j6" type="revolute">
    <parent link="j5_spindle_link"/>
    <child link="end_effector"/>
    <origin rpy="${pi/2} -0.000000 ${-pi/2}" xyz="0.1280 -0.0000 0.0510"/>
    <axis xyz="0 0 1"/>
    <limit lower="${pi/2}" upper="${-pi/2}" effort="1000.0" velocity="0.2"/>
  </joint>

</robot>
